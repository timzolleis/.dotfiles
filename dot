#!/usr/bin/env bash
#
# dot — dotfiles management CLI
#
# Layout:
#   home/            mirrored to ~ via `stow --no-folding` (files are symlinked
#                    individually; runtime dirs like ~/.pi/agent/sessions stay
#                    real and never touch this repo)
#   agents/          own skills; each ~/.agents/skills/<skill> is a directory
#                    symlink into this repo
#   packages/bundle  Brewfile
#   herdr-app/       a copy of ~/.config/herdr-app's own mods, layout, keys and tools;
#                    copied, not linked: Herdr reloads a mod only when a real
#                    file under ~/.config/herdr-app changes
#
set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly DOTFILES_DIR
readonly BREWFILE="${DOTFILES_DIR}/packages/bundle"
readonly SKILLS_DIR="${DOTFILES_DIR}/agents/.agents/skills"
readonly HERDR_HOME="${HOME}/.config/herdr-app"
readonly HERDR_COPY="${DOTFILES_DIR}/herdr-app"
readonly PI_PACKAGE="@earendil-works/pi-coding-agent"
readonly NODE_VERSION="24"

readonly RED='\033[0;31m' GREEN='\033[0;32m' YELLOW='\033[0;33m' BLUE='\033[0;34m' BOLD='\033[1m' RESET='\033[0m'

ok()   { echo -e "${GREEN}✓${RESET} $1"; }
warn() { echo -e "${YELLOW}⚠${RESET} $1"; }
err()  { echo -e "${RED}✗${RESET} $1" >&2; }
hdr()  { echo -e "\n${BOLD}${BLUE}==>${RESET} ${BOLD}$1${RESET}"; }

# Paths that must never be committed (secret-guard, checked by `dot doctor`).
readonly FORBIDDEN_TRACKED='(^|/)(auth\.json|mcp-oauth|sessions|run-history\.jsonl|mcp-cache\.json|node_modules)'

command_exists() { command -v "$1" >/dev/null 2>&1; }

# ─── stow ────────────────────────────────────────────────────────────────────
cmd_stow() {
    command_exists stow || { err "stow not installed (brew install stow)"; exit 1; }

    hdr "Stowing home/ → ~"
    stow --dir "$DOTFILES_DIR" --target "$HOME" --restow --no-folding home
    ok "stowed home/"

    # ~/.agents/skills must exist as a real directory, so stow links each
    # skill directory instead of folding ~/.agents into this repo (the skills
    # installer writes third-party skills there).
    mkdir -p "${HOME}/.agents/skills"
    stow --dir "$DOTFILES_DIR" --target "$HOME" --restow agents
    ok "stowed agents/"
}

# ─── herdr ───────────────────────────────────────────────────────────────────
# The person's own Herdr files: the -plus mods (the app regenerates their .d.ts
# and jsconfig.json), the layout, keys, settings and themes.
herdr_rsync() {
    # rsync takes the first rule that matches: the generated files are excluded first.
    rsync -a --delete --delete-excluded \
        --exclude='*.d.ts' --exclude='jsconfig.json' \
        --include='mods/' --include='mods/*-plus/' --include='mods/*-plus/**' --exclude='mods/**' \
        --include='layouts/' --include='layouts/tim.*' --exclude='layouts/**' \
        --include='themes/' --include='themes/**' \
        --include='tools/' --include='tools/*/' --include='tools/*/package.json' --include='tools/*/package-lock.json' --include='tools/*/*.mjs' \
        --include='keys.json' --include='settings.json' \
        --exclude='*' \
        "$@"
}

cmd_herdr() {
    case "${1:-}" in
        save)
            mkdir -p "$HERDR_COPY"
            herdr_rsync "${HERDR_HOME}/" "${HERDR_COPY}/"
            ok "copied ${HERDR_HOME} → ${HERDR_COPY}; review with: git -C $DOTFILES_DIR status herdr-app" ;;
        restore)
            [[ -d "$HERDR_COPY" ]] || { warn "no ${HERDR_COPY} yet"; return; }
            mkdir -p "$HERDR_HOME"
            # No --delete back into the app: it keeps files of its own there.
            rsync -a --exclude='*.d.ts' --exclude='jsconfig.json' "${HERDR_COPY}/" "${HERDR_HOME}/"
            # Tools (the Shiki server) get their packages back from their lockfiles.
            local tool
            for tool in "${HERDR_HOME}"/tools/*/; do
                [[ -f "${tool}package-lock.json" ]] && npm ci --prefix "$tool" --silent --no-audit --no-fund
            done
            ok "copied ${HERDR_COPY} → ${HERDR_HOME}" ;;
        *) err "usage: dot herdr save|restore"; exit 1 ;;
    esac
}

# ─── doctor ──────────────────────────────────────────────────────────────────
cmd_doctor() {
    local failures=0

    hdr "Tools"
    local tool
    for tool in brew stow git gh fnm node pi; do
        if command_exists "$tool"; then ok "$tool"; else err "$tool missing"; ((failures++)); fi
    done

    hdr "Stowed files"
    local rel file link
    while IFS= read -r file; do
        rel="${file#"$DOTFILES_DIR"/home/}"
        link="${HOME}/${rel}"
        if [[ -L "$link" && -e "$link" ]]; then
            :
        else
            err "$link is not a resolving symlink"
            ((failures++))
        fi
    done < <(find "$DOTFILES_DIR/home" -type f)
    [[ $failures -eq 0 ]] && ok "all stowed files resolve"

    hdr "Linked skills"
    local skill_failures=0 skill_dir
    for skill_dir in "$SKILLS_DIR"/*/; do
        skill_dir="${skill_dir%/}"
        link="${HOME}/.agents/skills/${skill_dir##*/}"
        if [[ -L "$link" && "$link" -ef "$skill_dir" ]]; then
            :
        else
            err "$link is not a directory symlink into $skill_dir"
            ((skill_failures++))
        fi
    done
    ((failures += skill_failures))
    [[ $skill_failures -eq 0 ]] && ok "all skills link into the repo"

    hdr "Herdr copy"
    if [[ -d "$HERDR_COPY" ]] && herdr_rsync --dry-run --itemize-changes "${HERDR_HOME}/" "${HERDR_COPY}/" | grep -q .; then
        warn "~/.config/herdr-app differs from the copy (run: dot herdr save)"
    else
        ok "herdr-app copy is current"
    fi

    hdr "Secret guard"
    local tracked
    if tracked=$(git -C "$DOTFILES_DIR" ls-files | grep -E "$FORBIDDEN_TRACKED"); then
        err "forbidden files tracked in git:"
        echo "$tracked" >&2
        ((failures++))
    else
        ok "no secrets/runtime files tracked"
    fi

    hdr "Brewfile"
    if brew bundle check --no-upgrade --file "$BREWFILE" >/dev/null 2>&1; then
        ok "all Brewfile packages installed"
    else
        warn "some Brewfile packages missing (run: brew bundle --file $BREWFILE)"
    fi

    echo
    if [[ $failures -gt 0 ]]; then
        err "doctor found $failures problem(s)"
        exit 1
    fi
    ok "healthy"
}

# ─── init ────────────────────────────────────────────────────────────────────
cmd_init() {
    hdr "1/4 Homebrew"
    if command_exists brew; then
        ok "already installed"
    else
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        eval "$(/opt/homebrew/bin/brew shellenv)"
        ok "installed"
    fi

    hdr "2/4 Brewfile packages"
    brew bundle --file "$BREWFILE"
    ok "brew bundle done"

    hdr "3/4 Node + pi"
    eval "$(fnm env)"
    fnm install "$NODE_VERSION"
    fnm default "$NODE_VERSION"
    fnm use "$NODE_VERSION"
    if command_exists pi; then
        ok "pi already installed"
    else
        npm install -g "$PI_PACKAGE"
        ok "pi installed"
    fi

    hdr "4/4 Symlinks"
    cmd_stow
    cmd_herdr restore

    hdr "Done — manual next steps"
    echo "  1. pi            # first run reinstalls packages from settings.json, then: /login"
    echo "  2. gh auth login"
    echo "  3. exec zsh      # pick up stowed .zshrc"
}

# ─── update ──────────────────────────────────────────────────────────────────
cmd_update() {
    hdr "Pulling dotfiles"
    git -C "$DOTFILES_DIR" pull --rebase

    hdr "Brew packages"
    brew bundle --file "$BREWFILE"

    cmd_stow

    hdr "Herdr"
    cmd_herdr restore
}

# ─── brew-dump ───────────────────────────────────────────────────────────────
cmd_brew_dump() {
    hdr "Dumping Brewfile"
    brew bundle dump --file "$BREWFILE" --describe --force
    ok "wrote $BREWFILE — review with: git -C $DOTFILES_DIR diff packages/bundle"
}

usage() {
    cat <<EOF
${BOLD}dot${RESET} — dotfiles management

Usage: dot <command>

Commands:
  init        Fresh-machine bootstrap (brew → packages → node/pi → stow)
  stow        Symlink home/ into ~ and maintain extra links
  doctor      Verify tools, symlinks, and that no secrets are tracked
  update      git pull + brew bundle + stow
  brew-dump   Regenerate packages/bundle from installed packages
  herdr save|restore
              Copy Herdr's mods, layout and keys into the repo, or back
EOF
}

case "${1:-}" in
    init)      cmd_init ;;
    stow)      cmd_stow ;;
    doctor)    cmd_doctor ;;
    update)    cmd_update ;;
    brew-dump) cmd_brew_dump ;;
    herdr)     cmd_herdr "${2:-}" ;;
    *)         usage; [[ -n "${1:-}" ]] && exit 1 ;;
esac
